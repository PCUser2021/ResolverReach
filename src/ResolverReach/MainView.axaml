<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResolverReach"
             x:Class="ResolverReach.MainView"
             x:DataType="vm:ResolverReachViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource AppBackgroundBrush}"
             KeyDown="MainView_KeyDown">
<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">
      <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="24">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Width="42" Height="42" CornerRadius="11" Background="#1473E6">
              <TextBlock Text="R" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Resolver Reach" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
              <TextBlock Text="DNS-over-HTTPS diagnostics · Windows x64" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
            </StackPanel>
          </StackPanel>
          <Menu Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextBrush}">
            <MenuItem x:Name="PasteMenuItem" Header="Paste Links"  />
          </Menu>
          <ComboBox x:Name="ThemeSelector" Grid.Column="2" Width="150" MinHeight="38" VerticalAlignment="Center"
                    SelectionChanged="ThemeSelector_SelectionChanged" AutomationProperties.Name="Application theme">
            <ComboBoxItem Content="System theme" Tag="Default" />
            <ComboBoxItem Content="Light theme" Tag="Light" />
            <ComboBoxItem Content="Dark theme" Tag="Dark" />
          </ComboBox>
        </Grid>
      </Border>
      <Border x:Name="StatusRibbon" Grid.Row="1" Background="#10375A" Padding="24,18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="5" VerticalAlignment="Center">
            <TextBlock x:Name="StatusRibbonTitle" Text="Ready to check DNS resolvers" FontSize="23" FontWeight="SemiBold" Foreground="#FFFFFF" />
            <TextBlock x:Name="StatusRibbonText" Text="Check the live cURL catalog or open Paste Links to test your own endpoints." FontSize="13" Foreground="#D9EBFF" TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="CheckNowButton" Grid.Column="1"  Padding="22,13" MinWidth="240" MinHeight="48" VerticalAlignment="Center"
                  Background="#1473E6" BorderBrush="#31A8FF" BorderThickness="1" CornerRadius="7"
                  AutomationProperties.Name="Check the cURL DoH resolver catalog">
            <TextBlock Text="Check the Curl Resolvers" FontSize="14" FontWeight="SemiBold" Foreground="White" />
          </Button>
        </Grid>
      </Border>
      <Border x:Name="PasteLinksPanel" Grid.Row="2" IsVisible="False" Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="Paste resolver links" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <TextBlock Text="One HTTPS DoH endpoint per line. Separate endpoints with line breaks or semicolons. Press Esc during a run to cancel."
                       FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="CheckPasteButton" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" 
                  Padding="24,10" MinWidth="120" MinHeight="42" VerticalAlignment="Center"
                  Background="#1473E6" BorderBrush="#31A8FF" BorderThickness="1" CornerRadius="7">
            <TextBlock Text="Check" FontSize="13" FontWeight="SemiBold" Foreground="White" />
          </Button>
          <TextBox x:Name="EndpointBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                   AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="7"
                   Watermark="https://cloudflare-dns.com/dns-query&#10;https://dns.google/dns-query"
                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13" Padding="12"
                   Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppInputTextBrush}"
                   BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6"
                   AutomationProperties.Name="Resolver endpoint URLs" />
          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="The app sends a test DNS query (example.com, A record) to each listed endpoint. Only use providers you trust."
                     FontSize="11" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
        </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="24,20,24,16" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
          <StackPanel Spacing="4">
            <TextBlock Text="Resolver results" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <TextBlock Text="PASS means a valid NOERROR DNS response. DNS ERROR means the HTTPS/DNS exchange was valid but returned a DNS error code; FAIL indicates an unreachable or invalid response."
                       FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,7" VerticalAlignment="Center">
            <TextBlock Text="MAX 512 ENDPOINTS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
          </Border>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,2">
          <Grid ColumnDefinitions="3*,110,95,2*" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="ENDPOINT / DETAILS" Margin="12,11" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}" />
            <TextBlock Grid.Column="1" Text="STATUS" Margin="9,11" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}" />
            <TextBlock Grid.Column="2" Text="LATENCY" Margin="9,11" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}" />
            <TextBlock Grid.Column="3" Text="DNS RESPONSE" Margin="9,11" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}" />
          </Grid>
        </Border>
        <Grid Grid.Row="2" MinHeight="180">
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="560">
            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AppSubtleBrush}" HorizontalAlignment="Center">
              <TextBlock Text="✓" FontSize="32" Foreground="#1473E6" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Ready when you are" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Click “Check the Curl Resolvers” to fetch the current public resolver list, or choose Paste Links to test specific endpoints."
                       TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" />
          </StackPanel>
          <ListBox x:Name="ResultsList" IsVisible="False" BorderThickness="0" Background="{DynamicResource AppBackgroundBrush}" SelectionMode="Single" HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ResolverResult">
                  <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,13">
                    <Grid ColumnDefinitions="3*,110,95,2*" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Endpoint}" FontSize="13" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Grid.Column="1" CornerRadius="5" Padding="8,5" Background="{Binding StatusBackground}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontSize="10" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Grid.Column="2" Text="{Binding LatencyLabel}" FontSize="12" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HttpLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                        <TextBlock Text="{Binding DnsSummary}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
      <Border Grid.Row="4" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="7">
            <TextBlock x:Name="StatusText" Text="Idle" FontSize="12" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap" />
            <ProgressBar x:Name="TestProgress" Minimum="0" Maximum="100" Value="0" Height="5" IsIndeterminate="False" />
          </StackPanel>
          <TextBlock x:Name="ProgressText" Grid.Column="1" Text="0 tested" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
        </Grid>
      </Border>
    </Grid>
</UserControl>