<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JDownloaderReach.MainWindow"
        Title="JDownloader Reach — download control and network tools"
        Width="1180" Height="940" MinWidth="920" MinHeight="700"
        CanResize="True" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22" Spacing="14">
      <Border Background="#34393F" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
          <Border Width="44" Height="44" CornerRadius="10" Background="#F22E8C" VerticalAlignment="Center">
            <TextBlock Text="JR" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="JDownloader Reach" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <TextBlock Text="Community desktop shell · download control · DNS diagnostics · GGUF tooling" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="2" Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,7" VerticalAlignment="Center">
            <TextBlock Text="PROTOTYPE 0.1.0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
          </Border>
        </Grid>
      </Border>

      <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="1. JDownloader engine" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
          <TextBlock Text="This shell delegates download work to your existing JDownloader installation. It can launch JDownloader and use its optional local API for LinkGrabber actions, queue summaries, and starting queued downloads." FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="JDownloaderPathBox" Grid.Column="0" Watermark="Path to JDownloader2.exe" FontSize="12" />
            <Button Grid.Column="1" Click="BrowseJDownloaderButton_Click" Padding="14,8" MinWidth="90">Browse…</Button>
          </Grid>
          <WrapPanel>
            <Button Click="LaunchJDownloaderButton_Click" Padding="16,9" Margin="0,0,8,8" Background="#F22E8C" Foreground="White">Launch JDownloader</Button>
            <Button Click="CheckApiButton_Click" Padding="16,9" Margin="0,0,8,8">Check local API</Button>
            <Button Click="RefreshQueueButton_Click" Padding="16,9" Margin="0,0,8,8">Refresh queue</Button>
            <Button Click="StartDownloadsButton_Click" Padding="16,9" Margin="0,0,8,8">Start queued downloads</Button>
          </WrapPanel>
          <TextBlock Text="Security: the API client is fixed to 127.0.0.1:3128. JDownloader's deprecated local API may be unauthenticated; do not expose the port to a LAN or the internet." FontSize="11" Foreground="#FFD38A" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="2. Send links to LinkGrabber" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
          <TextBlock Text="Paste one or more links below. JDownloader remains responsible for link extraction, plugins, account handling, and downloading." FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
          <TextBox x:Name="LinkInputBox" AcceptsReturn="True" MinHeight="100" MaxHeight="190" TextWrapping="Wrap" Watermark="Paste links here — one per line" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="AddLinksButton_Click" Padding="16,9" Background="#F22E8C" Foreground="White">Add to LinkGrabber</Button>
            <Button Click="ClearLinksButton_Click" Padding="16,9">Clear</Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="3. Download queue snapshot" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="RefreshQueueButton_Click" Padding="12,7">Refresh</Button>
          </Grid>
          <TextBlock Text="Read-only package snapshot queried from JDownloader. Detailed controls and host/plugin dialogs remain available in the original application." FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
          <TextBox x:Name="QueueSummaryBox" IsReadOnly="True" AcceptsReturn="True" MinHeight="100" MaxHeight="240" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Background="{DynamicResource AppInputBrush}" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
        <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
          <StackPanel Spacing="9">
            <TextBlock Text="4. Resolver Reach" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <TextBlock Text="Launch your existing DNS-over-HTTPS diagnostics app, preserving its DNS validation and ZIP log-export features." FontSize="11" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox x:Name="ResolverReachPathBox" Grid.Column="0" Watermark="ResolverReach.exe" FontSize="11" />
              <Button Grid.Column="1" Click="BrowseResolverReachButton_Click" Padding="10,7">Browse…</Button>
            </Grid>
            <Button Click="LaunchResolverReachButton_Click" Padding="14,8" HorizontalAlignment="Left" Background="#F22E8C" Foreground="White">Open Resolver Reach</Button>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
          <StackPanel Spacing="9">
            <TextBlock Text="5. Ollama GGUF Importer" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <TextBlock Text="Launch your existing GGUF importer to register local model files with Ollama. Model files are not uploaded by this shell." FontSize="11" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox x:Name="GgufImporterPathBox" Grid.Column="0" Watermark="Ollama-GGUF-Importer.exe" FontSize="11" />
              <Button Grid.Column="1" Click="BrowseGgufImporterButton_Click" Padding="10,7">Browse…</Button>
            </Grid>
            <Button Click="LaunchGgufImporterButton_Click" Padding="14,8" HorizontalAlignment="Left" Background="#F22E8C" Foreground="White">Open GGUF Importer</Button>
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="#34393F" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Spacing="5">
            <TextBlock Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}" />
            <TextBlock x:Name="StatusText" Text="Ready. Configure or launch your JDownloader installation." FontSize="12" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Click="SaveLogsButton_Click" Padding="16,9" VerticalAlignment="Center">Save Logs (.zip)</Button>
        </Grid>
      </Border>

      <TextBlock Text="Independent community project. Not affiliated with or endorsed by JDownloader, AppWork, or Ollama. This prototype is a control shell, not a complete C# port of JDownloader." FontSize="10" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
