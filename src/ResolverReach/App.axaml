<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia" x:Class="ResolverReach.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <styling:FluentAvaloniaTheme UseSystemFontOnWindows="True" CustomAccentColor="#147BFF" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E1D39" />
      <SolidColorBrush x:Key="AppSurfaceBrush" Color="#17294A" />
      <SolidColorBrush x:Key="AppSubtleBrush" Color="#12223F" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#F5FAFF" />
      <SolidColorBrush x:Key="AppMutedBrush" Color="#B9D4F5" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="#2D4D7C" />
      <SolidColorBrush x:Key="AppInputBrush" Color="#41464C" />
      <SolidColorBrush x:Key="AppInputTextBrush" Color="#FFFFFF" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
