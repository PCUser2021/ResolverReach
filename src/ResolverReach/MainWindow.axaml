<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ResolverReach.MainWindow"
        Title="Resolver Reach"
        Width="1280" Height="860"
        MinWidth="1000" MinHeight="700"
        Background="#F4F7FB"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="232,*" Background="#F4F7FB">
    <!-- Left navigation rail -->
    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4EAF2" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="22,26,18,24" Spacing="22">
          <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
            <Border Width="44" Height="44" CornerRadius="13" Background="#3658D4">
              <Grid>
                <Ellipse Width="24" Height="24" Stroke="#FFFFFF" StrokeThickness="2"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Width="7" Height="7" Fill="#FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Resolver Reach" FontSize="17" FontWeight="Bold" Foreground="#16213A" />
              <TextBlock Text="NETWORK DIAGNOSTICS" FontSize="9" FontWeight="SemiBold"
                         Foreground="#8491A7" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="9">
            <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold"
                       Foreground="#98A3B5" Margin="8,0,0,3" />
            <Border CornerRadius="10" Padding="12,12" Background="#EEF2FF">
              <Grid ColumnDefinitions="24,*" ColumnSpacing="9">
                <TextBlock Text="◈" FontSize="19" Foreground="#3658D4"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Resolver tests" FontSize="13" FontWeight="SemiBold" Foreground="#2B45B5" />
                  <TextBlock Text="DoH endpoint checks" FontSize="11" Foreground="#687BBE" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Margin="14,12,14,18" Padding="14"
                Background="#F8FAFC" BorderBrush="#E8EDF4" BorderThickness="1" CornerRadius="12">
          <StackPanel Spacing="9">
            <TextBlock Text="WHAT GETS TESTED" FontSize="10" FontWeight="SemiBold" Foreground="#8793A7" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="24" Height="24" CornerRadius="7" Background="#E5EDFF">
                <TextBlock Text="1" Foreground="#3658D4" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="HTTPS + TLS" FontSize="11" FontWeight="SemiBold" Foreground="#24324A" />
                <TextBlock Text="Secure connection" FontSize="10" Foreground="#7C899D" />
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="24" Height="24" CornerRadius="7" Background="#E5EDFF">
                <TextBlock Text="2" Foreground="#3658D4" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="DNS response" FontSize="11" FontWeight="SemiBold" Foreground="#24324A" />
                <TextBlock Text="RFC 8484 wire format" FontSize="10" Foreground="#7C899D" />
              </StackPanel>
            </StackPanel>
            <Border Height="1" Background="#E5EAF2" Margin="0,3" />
            <TextBlock Text="This tool does not change Windows DNS settings or route other traffic."
                       FontSize="10" Foreground="#7C899D" TextWrapping="Wrap" LineHeight="15" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Main workspace -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4EAF2" BorderThickness="0,0,0,1"
              Padding="28,17">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="NETWORK TOOLS  /  RESOLVER REACH" FontSize="10"
                       FontWeight="SemiBold" Foreground="#8A96AA" />
            <TextBlock Text="Resolver diagnostics" FontSize="18" FontWeight="SemiBold" Foreground="#18243A" />
          </StackPanel>
          <Border Grid.Column="1" BorderBrush="#DCE5F4" BorderThickness="1"
                  Background="#F8FAFF" CornerRadius="9" Padding="12,8" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="7" Height="7" Fill="#3A63D8" VerticalAlignment="Center" />
              <TextBlock Text="WINDOWS 11 · X64" FontSize="10" FontWeight="SemiBold" Foreground="#52678F" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,25,28,28" Spacing="19">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="DNS-over-HTTPS" FontSize="29" FontWeight="Bold"
                         Foreground="#17233B" />
              <TextBlock Text="Check which resolvers are reachable and returning valid DNS responses."
                         FontSize="13" Foreground="#6D7A90" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="7">
              <Border Background="#E8F7F0" CornerRadius="7" Padding="10,6">
                <TextBlock Text="PROTOCOL-LEVEL TEST" FontSize="9" FontWeight="Bold" Foreground="#187653" />
              </Border>
              <TextBlock Text="No system configuration changes" FontSize="10"
                         Foreground="#8793A6" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>

          <Border Background="#FFFFFF" BorderBrush="#E1E8F1" BorderThickness="1"
                  CornerRadius="14" Padding="21">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Endpoint list" FontSize="15" FontWeight="SemiBold" Foreground="#1C2941" />
                  <TextBlock Text="Add one HTTPS DoH URL per line, or separate URLs with semicolons."
                             FontSize="12" Foreground="#7C899D" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="#F2F5FA" CornerRadius="7" Padding="10,6"
                        VerticalAlignment="Center">
                  <TextBlock Text="MAX 50" FontSize="10" FontWeight="SemiBold" Foreground="#68768D" />
                </Border>
              </Grid>

              <TextBox x:Name="EndpointBox"
                       Text="{Binding EndpointInput, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       MinLines="5" MaxLines="6"
                       Watermark="https://cloudflare-dns.com/dns-query&#10;https://dns.google/dns-query"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       FontSize="12" Padding="13"
                       Background="#FBFCFE" Foreground="#24324A"
                       BorderBrush="#D7E0EC" BorderThickness="1" CornerRadius="9" />

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="Test query: example.com · A record" FontSize="11"
                             FontWeight="SemiBold" Foreground="#56657C" />
                  <TextBlock Text="Validates DNS ID, question, response flags and RCODE."
                             FontSize="10" Foreground="#929DB0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button x:Name="SamplesButton" Click="Samples_Click" Padding="14,10"
                          Background="#FFFFFF" BorderBrush="#D7E0EC" BorderThickness="1" CornerRadius="8">
                    <TextBlock Text="Load samples" FontSize="12" Foreground="#40506A" />
                  </Button>
                  <Button x:Name="CancelButton" Click="Cancel_Click" IsEnabled="False" Padding="13,10"
                          Background="#FFFFFF" BorderBrush="#D7E0EC" BorderThickness="1" CornerRadius="8">
                    <TextBlock Text="Cancel" FontSize="12" Foreground="#40506A" />
                  </Button>
                  <Button x:Name="RunButton" Click="RunTests_Click" Padding="18,10"
                          Background="#3658D4" BorderBrush="#3658D4" BorderThickness="1" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="▶" FontSize="10" Foreground="#FFFFFF" VerticalAlignment="Center" />
                      <TextBlock Text="Run tests" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="#FFFFFF" BorderBrush="#E1E8F1" BorderThickness="1"
                  CornerRadius="14" Padding="21">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,17">
                <StackPanel Spacing="4">
                  <TextBlock Text="Test results" FontSize="15" FontWeight="SemiBold" Foreground="#1C2941" />
                  <TextBlock Text="A pass requires a valid DNS reply — an open HTTPS connection is not enough."
                             FontSize="12" Foreground="#7C899D" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ExportButton" Grid.Column="1" Click="Export_Click" IsEnabled="False"
                        Padding="13,8" VerticalAlignment="Center"
                        Background="#FFFFFF" BorderBrush="#D7E0EC" BorderThickness="1" CornerRadius="8">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="↓" FontSize="14" Foreground="#40506A" />
                    <TextBlock Text="Export CSV" FontSize="11" Foreground="#40506A" />
                  </StackPanel>
                </Button>
              </Grid>

              <Border Grid.Row="1" Margin="0,0,0,2" Background="#F7F9FC"
                      BorderBrush="#ECF0F5" BorderThickness="0,1,0,1" CornerRadius="6">
                <Grid ColumnDefinitions="3*,112,90,2*" ColumnSpacing="12">
                  <TextBlock Grid.Column="0" Text="ENDPOINT / DETAILS" Margin="10,10"
                             FontSize="9" FontWeight="Bold" Foreground="#7E8BA0" />
                  <TextBlock Grid.Column="1" Text="STATUS" Margin="8,10"
                             FontSize="9" FontWeight="Bold" Foreground="#7E8BA0" />
                  <TextBlock Grid.Column="2" Text="LATENCY" Margin="8,10"
                             FontSize="9" FontWeight="Bold" Foreground="#7E8BA0" />
                  <TextBlock Grid.Column="3" Text="RESPONSE" Margin="8,10"
                             FontSize="9" FontWeight="Bold" Foreground="#7E8BA0" />
                </Grid>
              </Border>

              <Grid Grid.Row="2" MinHeight="150">
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="8" MaxWidth="390">
                  <Border Width="44" Height="44" CornerRadius="14" Background="#F0F4FB"
                          HorizontalAlignment="Center">
                    <TextBlock Text="⌁" FontSize="25" Foreground="#91A2C0"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="Ready to check your resolvers" FontSize="13" FontWeight="SemiBold"
                             Foreground="#5C6A80" HorizontalAlignment="Center" />
                  <TextBlock Text="Enter endpoint URLs above and run a test. Results will appear here with status and response timing."
                             TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                             Foreground="#9AA5B6" HorizontalAlignment="Center" />
                </StackPanel>
                <ScrollViewer x:Name="ResultsScroll" IsVisible="False" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#EFF2F7" BorderThickness="0,0,0,1" Padding="10,12">
                          <Grid ColumnDefinitions="3*,112,90,2*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Endpoint}" FontSize="12" Foreground="#233149"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#8290A4"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="6" Padding="8,5"
                                    Background="{Binding StatusBackground}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}"
                                         FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding LatencyLabel}"
                                       FontSize="12" Foreground="#40506A" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                              <TextBlock Text="{Binding HttpLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#40506A" />
                              <TextBlock Text="{Binding DnsSummary}" FontSize="10" Foreground="#8290A4"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>

              <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,13,0,0">
                <StackPanel Spacing="7">
                  <TextBlock x:Name="StatusText" Text="Ready when you are"
                             FontSize="11" Foreground="#65738A" />
                  <ProgressBar x:Name="TestProgress" Minimum="0" Maximum="100" Value="0"
                               Height="4" IsIndeterminate="False" />
                </StackPanel>
                <TextBlock x:Name="ProgressText" Grid.Column="1" Text="0 tested"
                           VerticalAlignment="Center" Margin="18,0,0,0"
                           FontSize="10" Foreground="#8995A8" />
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="28,11" Background="#FFFFFF"
              BorderBrush="#E4EAF2" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="#27A879" VerticalAlignment="Center" />
            <TextBlock Text="LOCAL DIAGNOSTIC TOOL" FontSize="9" FontWeight="SemiBold" Foreground="#8692A5" />
            <TextBlock Text="·" FontSize="10" Foreground="#C2CAD5" />
            <TextBlock Text="No background monitoring" FontSize="10" Foreground="#9AA5B5" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="v1.0.0" FontSize="10" Foreground="#9AA5B5" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
