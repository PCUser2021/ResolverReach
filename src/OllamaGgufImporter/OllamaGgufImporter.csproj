    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OllamaGgufImporter</RootNamespace>
    <AssemblyName>Ollama-GGUF-Importer</AssemblyName>
    <ApplicationIcon>Assets\OllamaGgufImporter.ico</ApplicationIcon>
    <Version>1.0.0</Version>
