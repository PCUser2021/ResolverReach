<windowing:AppWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:windowing="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
                     x:Class="ResolverReach.MainWindow"
                     Title="Resolver Reach"
                     Width="600" Height="175"
                     MinWidth="600" MinHeight="175"
                     CanResize="False"
                     Background="{x:Null}"
                     WindowStartupLocation="CenterScreen">
  <Window.Content>
    <Panel>
      <ExperimentalAcrylicBorder IsHitTestVisible="False">
        <ExperimentalAcrylicBorder.Material>
          <ExperimentalAcrylicMaterial BackgroundSource="None"
                                       TintColor="#242126"
                                       TintOpacity="0.94"
                                       MaterialOpacity="0.86" />
        </ExperimentalAcrylicBorder.Material>
      </ExperimentalAcrylicBorder>

      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10"
                    Margin="10" IsVisible="{OnPlatform Default=False, Windows=True}">
          <TextBlock Text="Resolver Reach" FontSize="11" Foreground="#D7CBD8"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- OnionFruit-inspired compact status ribbon -->
        <Border x:Name="StatusRibbon" DockPanel.Dock="Top"
                Background="#512144" Padding="20,10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock x:Name="StatusRibbonTitle" Text="Resolver diagnostics ready"
                         FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" />
              <TextBlock x:Name="StatusRibbonText" Text="No test run yet · HTTPS DNS exchange validation"
                         FontSize="10" Foreground="#F1D5E8" />
            </StackPanel>
            <Button Grid.Column="1" Click="OpenTester_Click"
                    Padding="15,8" VerticalAlignment="Center"
                    Background="#c71585" BorderBrush="#EA70B8" BorderThickness="1"
                    CornerRadius="4">
              <TextBlock Text="Test endpoints" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
            </Button>
          </Grid>
        </Border>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="15,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Batch DNS-over-HTTPS testing" FontSize="11"
                       FontWeight="SemiBold" Foreground="#E4D9E6" />
            <TextBlock Text="·" FontSize="11" Foreground="#84778A" />
            <TextBlock Text="Up to 50 URLs per run" FontSize="10" Foreground="#B4A8B8" />
          </StackPanel>
          <Button Grid.Column="1" Click="OpenTester_Click"
                  Padding="18,0" CornerRadius="0"
                  Background="Transparent" BorderBrush="Transparent"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" FontSize="11" Foreground="#E4D9E6" />
          </Button>
        </Grid>
      </DockPanel>
    </Panel>
  </Window.Content>
</windowing:AppWindow>
